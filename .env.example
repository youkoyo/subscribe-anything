# Database
# Choose local or remote. DATABASE_TARGET takes precedence over DATABASE_URL.
DATABASE_TARGET=local
DATABASE_URL_LOCAL=postgresql://subscribe:subscribe@localhost:5432/subscribe_anything
DATABASE_URL_REMOTE=postgresql://postgres:<password>@47.97.114.189:5432/nebula_prism_industry_info

# Legacy single-URL fallback. Used only when DATABASE_TARGET is unset.
# DATABASE_URL=postgresql://subscribe:subscribe@localhost:5432/subscribe_anything

# Service
PORT=3000
NODE_ENV=development

# Cloudflare Turnstile captcha (optional)
# Create a Turnstile widget in Cloudflare dashboard:
# https://dash.cloudflare.com/ -> Turnstile -> Add widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAA...

# Base URL for links in emails
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: uses Firecrawl for webpage sources discovered by the legacy AI path.
# RSS sources never consume this API.
FIRECRAWL_API_KEY=
